{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobblemonkinetics.dev/schemas/mod-export-manifest.schema.json",
  "title": "Mod work profile export manifest",
  "description": "Deterministic provenance contract for work profiles explicitly handed off to the mod repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "source", "publication", "files"],
  "properties": {
    "manifest_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "publication_manifest_sha256"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "publication_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "schema_version", "bundle_content_sha256"],
      "properties": {
        "batch_id": { "$ref": "resource-location.schema.json" },
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "bundle_content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "profile_id", "format_version", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^work_profiles/[a-z0-9](?:[a-z0-9_.-]*[a-z0-9])?\\.json$"
          },
          "profile_id": { "$ref": "resource-location.schema.json" },
          "format_version": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

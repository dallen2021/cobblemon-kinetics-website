{
  "name": "@cobblemon-kinetics/data-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic import, publication, access, and asset tooling for Cobblemon Kinetics.",
  "bin": {
    "ck-import-workbook": "./dist/cli/import-workbook.js",
    "ck-apply-publication": "./dist/cli/apply-publication.js",
    "ck-verify-published": "./dist/cli/verify-published.js",
    "ck-export-mod-work-profiles": "./dist/cli/export-mod-work-profiles.js",
    "ck-validate-assets": "./dist/cli/validate-assets.js",
    "ck-access-grant": "./dist/cli/access-grant.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @cobblemon-kinetics/domain build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @cobblemon-kinetics/domain build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @cobblemon-kinetics/domain build && vitest run",
    "import:workbook": "pnpm --filter @cobblemon-kinetics/domain build && tsx src/cli/import-workbook.ts",
    "apply:publication": "pnpm --filter @cobblemon-kinetics/domain build && tsx src/cli/apply-publication.ts",
    "verify:published": "pnpm --filter @cobblemon-kinetics/domain build && tsx src/cli/verify-published.ts",
    "export:mod-work-profiles": "pnpm --filter @cobblemon-kinetics/domain build && tsx src/cli/export-mod-work-profiles.ts",
    "validate:assets": "pnpm --filter @cobblemon-kinetics/domain build && tsx src/cli/validate-assets.ts",
    "access:grant": "pnpm --filter @cobblemon-kinetics/domain build && tsx src/cli/access-grant.ts"
  },
  "dependencies": {
    "@cobblemon-kinetics/domain": "workspace:*",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

# Browser-safe Supabase connection values. The publishable key is intentionally public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only application configuration.
SITE_ACCESS_MODE=private
APP_BASE_URL=http://127.0.0.1:3000
SUPABASE_SECRET_KEY=
# Repository in owner/name form for hosted reconciliation and clean-checkout mod exports.
GITHUB_REPOSITORY=
# Optional; reconciliation otherwise uses the repository's GitHub default branch.
PUBLICATION_BRANCH=
PUBLICATION_SIGNING_KEY=
ASSET_PRIVATE_BUCKET=asset-candidates
ASSET_PUBLIC_BUCKET=published-assets
BACKUP_AGE_RECIPIENT=
# Optional for root backup:create only: local or linked (default linked).
BACKUP_SOURCE=linked

# Safe local/preview fixture mode. Never enable this in a production deployment.
STUDIO_FIXTURE_MODE=false
